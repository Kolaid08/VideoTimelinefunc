@model IEnumerable<VideoTimelineApp.Models.VideoSession>
@{
    ViewBag.Title = "Thư viện Video";
}

<div class="page-home">

    <!-- ── Upload Card ── -->
    <section class="upload-card card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
            <h2 class="section-title" style="margin-bottom:0">📂 Upload video mới</h2>
            @if (ViewBag.CloudinaryConfigured == true)
            {
                <span style="font-size:0.75rem; color:#38bdf8; background:rgba(56,189,248,0.12); padding:4px 10px; border-radius:12px; font-weight:600;">☁️ Cloudinary: Đang hoạt động</span>
            }
            else
            {
                <span style="font-size:0.75rem; color:#f59e0b; background:rgba(245,158,11,0.12); padding:4px 10px; border-radius:12px; font-weight:600;" title="Nhập thông tin trong Web.config để bật lưu trữ Cloudinary">💻 Lưu cục bộ (Chưa cấu hình Cloudinary)</span>
            }
        </div>
        @using (Html.BeginForm("Upload", "Home", FormMethod.Post,
                    new { enctype = "multipart/form-data", id = "upload-form" }))
        {
            @Html.AntiForgeryToken()
            <div class="upload-fields">
                <div class="field-group">
                    <label class="field-label" for="title">Tên video</label>
                    <input class="field-input" type="text" id="title" name="title"
                           placeholder="Để trống sẽ dùng tên file" maxlength="255" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="file">Chọn file video</label>
                    <div id="drop-zone" class="drop-zone">
                        <span class="drop-icon">🎬</span>
                        <p>Kéo thả hoặc <span class="drop-link" onclick="document.getElementById('file').click()">bấm chọn file</span></p>
                        <p class="drop-hint">MP4 · MOV · MKV · AVI · WEBM – tối đa 500 MB</p>
                        <p class="drop-chosen" id="chosen-name" style="display:none"></p>
                        <input type="file" id="file" name="file" accept="video/*" style="display:none"
                               onchange="onFileChosen(this)" />
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-upload" id="upload-btn">
                ⬆️ Upload & Mở Timeline
            </button>
        }
        <div class="upload-progress" id="upload-progress" style="display:none">
            <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
            <p class="progress-text">Đang upload…</p>
        </div>
    </section>

    <!-- ── Video Library ── -->
    <section>
        <h2 class="section-title">📚 Thư viện video (@Model.Count() video)</h2>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <span>🎞</span>
                <p>Chưa có video nào. Hãy upload video đầu tiên!</p>
            </div>
        }
        else
        {
            <div class="video-grid">
                @foreach (var v in Model)
                {
                    <div class="video-card">
                        <div class="vc-header">
                            <span class="vc-icon">🎬</span>
                            <div class="vc-meta">
                                <div class="vc-title" title="@v.OriginalFileName">@v.Title</div>
                                <div class="vc-sub">
                                    @if (!string.IsNullOrEmpty(v.VideoUrl))
                                    {
                                        <span style="color:#38bdf8; font-weight:600">☁️ Cloud</span>
                                    }
                                    else
                                    {
                                        <span style="color:#94a3b8; font-weight:600">💻 Local</span>
                                    }
                                    · @v.OriginalFileName
                                </div>
                            </div>
                        </div>
                        <div class="vc-stats">
                            <div class="vc-stat">
                                <span class="vc-stat-lbl">Thời lượng</span>
                                <span class="vc-stat-val">@(v.Duration > 0 ? FormatDuration(v.Duration) : "--:--")</span>
                            </div>
                            <div class="vc-stat">
                                <span class="vc-stat-lbl">Kích thước</span>
                                <span class="vc-stat-val">@FormatSize(v.FileSize)</span>
                            </div>
                            <div class="vc-stat">
                                <span class="vc-stat-lbl">Đoạn đánh dấu</span>
                                <span class="vc-stat-val">@v.Segments.Count đoạn</span>
                            </div>
                            <div class="vc-stat">
                                <span class="vc-stat-lbl">Upload lúc</span>
                                <span class="vc-stat-val">@v.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </div>
                        @if (v.Segments.Any())
                        {
                            <div class="vc-seg-badges">
                                @foreach (var s in v.Segments.Take(5))
                                {
                                    <span class="seg-badge-mini @(s.Type == "incident" ? "badge-inc" : "badge-nor")"
                                          style="border-color:@s.Color"
                                          title="@(string.IsNullOrEmpty(s.Label) ? "Chưa đặt tên" : s.Label): @FormatDuration(s.StartTime) → @FormatDuration(s.EndTime)">
                                        @(s.Type == "incident" ? "⚠️" : "🏷") @FormatDuration(s.StartTime)
                                    </span>
                                }
                                @if (v.Segments.Count > 5)
                                {
                                    <span class="seg-badge-mini">+@(v.Segments.Count - 5) nữa</span>
                                }
                            </div>
                        }
                        <div class="vc-actions">
                            <a href="@Url.Action("Player","Video", new { id = v.Id })"
                               class="btn btn-open">▶ Mở Timeline</a>
                            @using (Html.BeginForm("Delete", "Home", new { id = v.Id },
                                        FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-del-video"
                                        onclick="return confirm('Xoá video và tất cả đoạn đánh dấu?')">🗑</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

</div>

@functions {
    string FormatDuration(double sec)
    {
        if (sec <= 0) return "--:--";
        int h = (int)(sec / 3600);
        int m = (int)((sec % 3600) / 60);
        int s = (int)(sec % 60);
        return h > 0
            ? string.Format("{0}:{1:D2}:{2:D2}", h, m, s)
            : string.Format("{0:D2}:{1:D2}", m, s);
    }
    string FormatSize(long bytes)
    {
        if (bytes >= 1073741824) return string.Format("{0:F1} GB", bytes / 1073741824.0);
        if (bytes >= 1048576)    return string.Format("{0:F1} MB", bytes / 1048576.0);
        if (bytes >= 1024)       return string.Format("{0:F0} KB", bytes / 1024.0);
        return bytes + " B";
    }
}

@section Scripts {
<script>
function onFileChosen(input) {
    if (!input.files.length) return;
    var name = input.files[0].name;
    document.getElementById('chosen-name').textContent = '📎 ' + name;
    document.getElementById('chosen-name').style.display = 'block';
    if (!document.getElementById('title').value)
        document.getElementById('title').value = name.replace(/\.[^.]+$/, '');
}

// Drag & drop on upload zone
var dz = document.getElementById('drop-zone');
dz.addEventListener('dragover', function(e) { e.preventDefault(); dz.classList.add('dz-over'); });
dz.addEventListener('dragleave', function() { dz.classList.remove('dz-over'); });
dz.addEventListener('drop', function(e) {
    e.preventDefault(); dz.classList.remove('dz-over');
    var fi = document.getElementById('file');
    fi.files = e.dataTransfer.files;
    onFileChosen(fi);
});

var isCloudinary = @(ViewBag.CloudinaryConfigured == true ? "true" : "false");

// Show progress & handle direct Client-Side Upload
document.getElementById('upload-form').addEventListener('submit', function(e) {
    var fi = document.getElementById('file');
    if (!fi.files.length) return;

    // Fallback: If Cloudinary is not configured, submit standard form to local IIS
    if (!isCloudinary) {
        document.getElementById('upload-btn').disabled = true;
        document.getElementById('upload-progress').style.display = 'block';
        return;
    }

    // ── Client-Side Direct Upload to Cloudinary ──
    e.preventDefault();
    var file = fi.files[0];
    var title = document.getElementById('title').value;

    var btn   = document.getElementById('upload-btn');
    var prog  = document.getElementById('upload-progress');
    var fill  = document.getElementById('progress-fill');
    var ptext = document.querySelector('.progress-text');

    btn.disabled = true;
    prog.style.display = 'block';
    fill.style.width = '5%';
    ptext.textContent = 'Đang khởi tạo chứng thực...';

    // Step 1: Get secure timestamped signature from server (10ms)
    fetch('@Url.Action("GetUploadSignature", "Home")')
        .then(function(res) { return res.json(); })
        .then(function(sigRes) {
            if (!sigRes.success || !sigRes.data) {
                throw new Error(sigRes.message || 'Không lấy được chữ ký Cloudinary!');
            }

            var sig = sigRes.data;
            ptext.textContent = 'Đang tải video trực tiếp lên Cloudinary (0%)...';

            // Step 2: Upload file DIRECTLY from browser to Cloudinary CDN (bypassing ngrok completely)
            var formData = new FormData();
            formData.append('file', file);
            formData.append('api_key', sig.apiKey);
            formData.append('timestamp', sig.timestamp);
            formData.append('signature', sig.signature);
            formData.append('folder', sig.folder);

            var xhr = new XMLHttpRequest();
            xhr.open('POST', 'https://api.cloudinary.com/v1_1/' + sig.cloudName + '/video/upload', true);

            xhr.upload.onprogress = function(pe) {
                if (pe.lengthComputable) {
                    var pct = Math.round((pe.loaded / pe.total) * 95);
                    fill.style.width = pct + '%';
                    ptext.textContent = 'Đang tải video trực tiếp lên Cloudinary (' + pct + '%)...';
                }
            };

            xhr.onload = function() {
                if (xhr.status >= 200 && xhr.status < 300) {
                    fill.style.width = '100%';
                    ptext.textContent = 'Đã tải xong! Đang lưu thông tin vào CSDL...';

                    var cRes = JSON.parse(xhr.responseText);

                    // Step 3: Send tiny JSON metadata to server to save in SQL Server
                    fetch('@Url.Action("SaveUploadedVideo", "Home")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            title: title,
                            originalFileName: file.name,
                            videoUrl: cRes.secure_url,
                            publicId: cRes.public_id,
                            duration: cRes.duration || 0,
                            fileSize: cRes.bytes || file.size
                        })
                    })
                    .then(function(sRes) { return sRes.json(); })
                    .then(function(saved) {
                        if (saved.success && saved.redirectUrl) {
                            window.location.href = saved.redirectUrl;
                        } else {
                            throw new Error(saved.message || 'Lỗi lưu vào CSDL!');
                        }
                    })
                    .catch(function(err) {
                        alert('Lỗi lưu CSDL: ' + err.message);
                        btn.disabled = false;
                        prog.style.display = 'none';
                    });
                } else {
                    var errObj = {};
                    try { errObj = JSON.parse(xhr.responseText); } catch(err) {}
                    var errMsg = (errObj.error && errObj.error.message) ? errObj.error.message : ('Lỗi HTTP ' + xhr.status);
                    alert('Lỗi tải lên Cloudinary: ' + errMsg);
                    btn.disabled = false;
                    prog.style.display = 'none';
                }
            };

            xhr.onerror = function() {
                alert('Lỗi kết nối mạng khi tải lên Cloudinary!');
                btn.disabled = false;
                prog.style.display = 'none';
            };

            xhr.send(formData);
        })
        .catch(function(err) {
            alert('Lỗi: ' + err.message);
            btn.disabled = false;
            prog.style.display = 'none';
        });
});
</script>
}
